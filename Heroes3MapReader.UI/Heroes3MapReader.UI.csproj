<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework Condition="'$(MobileTargetFramework)' != ''">$(MobileTargetFramework)</TargetFramework>
        <TargetFramework Condition="'$(MobileTargetFramework)' == '' And '$(DesktopTargetFramework)' != ''">$(DesktopTargetFramework)</TargetFramework>
        <TargetFramework Condition="'$(MobileTargetFramework)' == '' And '$(DesktopTargetFramework)' == '' And '$(EnableAndroidTargeting)' == 'true'">net8.0-android34.0</TargetFramework>
        <TargetFramework Condition="'$(MobileTargetFramework)' == '' And '$(DesktopTargetFramework)' == '' And '$(EnableAndroidTargeting)' != 'true'">net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AssemblyName>Heroes3MapReader</AssemblyName>
        <RootNamespace>Heroes3MapReader.UI</RootNamespace>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net6.0-windows7.0'">
        <OutputType>WinExe</OutputType>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="11.1.3" Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net6.0-windows7.0'" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
        <PackageReference Include="Avalonia.ReactiveUI" Version="11.1.3" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.1.3" />
        <PackageReference Include="Avalonia.Diagnostics" Version="11.1.3" Condition="'$(Configuration)|$(TargetFramework)' == 'Debug|net8.0' Or '$(Configuration)|$(TargetFramework)' == 'Debug|net6.0-windows7.0'" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
        <PackageReference Include="NTextCat" Version="0.3.65" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Heroes3MapReader.Logic\Heroes3MapReader.Logic.csproj"
                          AdditionalProperties="EnableAndroidTargeting=$(EnableAndroidTargeting);MobileTargetFramework=$(MobileTargetFramework);DesktopTargetFramework=$(DesktopTargetFramework)" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-android34.0' Or '$(TargetFramework)' == 'net8.0-ios'">
        <Compile Remove="Program.cs" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\SpellNames.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>SpellNames.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\FactionNames.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>FactionNames.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\MapFormatNames.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>MapFormatNames.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\VictoryConditionNames.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>VictoryConditionNames.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\SpellNames.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>SpellNames.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\FactionNames.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>FactionNames.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\MapFormatNames.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>MapFormatNames.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\VictoryConditionNames.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>VictoryConditionNames.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\SpellSelectionWindow.axaml.cs">
        <DependentUpon>SpellSelectionWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\PlayableFactionsControl.axaml.cs">
        <DependentUpon>PlayableFactionsControl.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\MapSizeFilterControl.axaml.cs">
        <DependentUpon>MapSizeFilterControl.axaml</DependentUpon>
      </Compile>
    </ItemGroup>
    <ItemGroup>
        <None Include="$(NuGetPackageRoot)ntextcat\0.3.65\content\LanguageModels\*.profile.xml"
              Link="LanguageModels\%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"
              Condition="Exists('$(NuGetPackageRoot)ntextcat\0.3.65\content\LanguageModels')" />
    </ItemGroup>

</Project>
